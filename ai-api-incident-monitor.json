        400,
        0
      ],
      "name": "Get Previous Results"
    },
    {
      "parameters": {
        "jsCode": "const results = $input.all().map(item => item.json);\n\n// Sort newest → oldest\nresults.sort((a, b) => new Date(b.tested_at) - new Date(a.tested_at));\n\nconst recent = results.slice(0, 10);\n\nconst total = recent.length;\n\nconst passCount = recent.filter(r => r.result === 'PASS').length;\nconst warningCount = recent.filter(r => r.result === 'WARNING').length;\nconst failCount = recent.filter(r => r.result === 'FAIL').length;\n\n// Response times\nconst responseTimes = recent\n  .map(r => Number(r.response_time))\n  .filter(Number.isFinite);\n\nconst averageResponseTime = responseTimes.length\n  ? Math.round(\n      responseTimes.reduce((sum, value) => sum + value, 0) /\n      responseTimes.length\n    )\n  : 0;\n\nconst latestResponseTime =\n  recent.length > 0 && Number.isFinite(Number(recent[0].response_time))\n    ? Number(recent[0].response_time)\n    : null;\n\n// Analyze last 3 checks\nconst last3 = recent.slice(0, 3);\n\nconst recentIncidents = last3.filter(\n  r => r.result === 'FAIL' || r.result === 'WARNING'\n).length;\n\n// Determine trend\nlet trend = 'STABLE';\n\nif (recentIncidents >= 2) {\n  trend = 'DEGRADING';\n} else if (\n  latestResponseTime !== null &&\n  averageResponseTime > 0 &&\n  latestResponseTime > averageResponseTime * 1.5\n) {\n  trend = 'SLOWING_DOWN';\n}\n\nreturn [\n  {\n    json: {\n      serviceName: recent[0]?.service_name ?? null,\n      analyzedResults: total,\n\n      passCount,\n      warningCount,\n      failCount,\n\n      averageResponseTime,\n      latestResponseTime,\n\n      recentIncidents,\n      trend,\n\n      latestResult: recent[0]?.result ?? null,\n      latestTestedAt: recent[0]?.tested_at ?? null\n    }\n  }\n];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        560,
        0
