    {
      "parameters": {
        "jsCode": "const response = $input.first().json;\nconst config = $('Start Timer').first().json;\n\nconst responseTime = Date.now() - config.requestStartedAt;\n\nconst responseBody = response.body ?? {};\n\n// 1. HTTP STATUS CHECK\nconst statusPassed =\n  response.statusCode === config.expectedStatus;\n\n// 2. RESPONSE TIME CHECK\nconst responseTimePassed =\n  responseTime <= config.maxResponseTime;\n\n// 3. REQUIRED FIELDS CHECK\nconst requiredFields = config.requiredFields || [];\n\nconst missingFields = requiredFields.filter(\n  field => !(field in responseBody)\n);\n\nconst requiredFieldsPassed =\n  missingFields.length === 0;\n\n// 4. EXPECTED VALUES CHECK\nconst expectedValues = config.expectedValues || {};\n\nconst incorrectValues = [];\n\nfor (const [key, expectedValue] of Object.entries(expectedValues)) {\n  if (responseBody[key] !== expectedValue) {\n    incorrectValues.push({\n      field: key,\n      expected: expectedValue,\n      actual: responseBody[key]\n    });\n  }\n}\n\nconst expectedValuesPassed =\n  incorrectValues.length === 0;\n\n// 5. RESPONSE STRUCTURE CHECK\nconst responseStructurePassed =\n  responseBody !== null &&\n  typeof responseBody === 'object' &&\n  !Array.isArray(responseBody);\n\n// FINAL RESULT\nlet result = 'PASS';\n\nif (\n  !statusPassed ||\n  !requiredFieldsPassed ||\n  !expectedValuesPassed ||\n  !responseStructurePassed\n) {\n  result = 'FAIL';\n} else if (!responseTimePassed) {\n  result = 'WARNING';\n}\n\nreturn [\n  {\n    json: {\n      testName: config.testName,\n      serviceName: config.serviceName,\n      testedUrl: config.url,\n\n      result,\n\n      statusCode: response.statusCode,\n      expectedStatus: config.expectedStatus,\n      statusPassed,\n\n      responseTime,\n      maxResponseTime: config.maxResponseTime,\n      responseTimePassed,\n\n      requiredFieldsPassed,\n      missingFields,\n\n      expectedValuesPassed,\n      incorrectValues,\n\n      responseStructurePassed,\n\n      testedAt: new Date().toISOString(),\n\n      responseBody\n    }\n  }\n];"
      },
