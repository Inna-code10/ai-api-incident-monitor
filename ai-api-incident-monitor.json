    {
      "parameters": {
        "jsCode": "const test = $(\"Save Test Result\").first().json;\nconst trend = $(\"Trend Analysis\").first().json;\nconst ai = $(\"Save AI Analysis\").first().json;\n\nreturn [\n  {\n    json: {\n      timestamp: new Intl.DateTimeFormat('sv-SE', {\n      timeZone: 'Europe/Nicosia',\n      year: 'numeric',\n      month: '2-digit',\n      day: '2-digit',\n      hour: '2-digit',\n      minute: '2-digit',\n      second: '2-digit',\n      hour12: false\n    }).format(new Date()),\n\n      testName: test.test_name,\n      serviceName: test.service_name,\n      testedUrl: test.tested_url,\n\n      result: test.result,\n\n      statusCode: test.status_code,\n      expectedStatus: test.expected_status,\n      statusPassed: test.status_passed,\n\n      responseTime: test.response_time,\n      maxResponseTime: test.max_response_time,\n      responseTimePassed: test.response_time_passed,\n\n      requiredFieldsPassed: test.required_fields_passed,\n      missingFields: JSON.stringify(test.missing_fields || []),\n\n      expectedValuesPassed: test.expected_values_passed,\n      incorrectValues: JSON.stringify(test.incorrect_values || []),\n\n      responseStructurePassed: test.response_structure_passed,\n\n      trend: trend.trend,\n      analyzedResults: trend.analyzedResults,\n      passCount: trend.passCount,\n      warningCount: trend.warningCount,\n      failCount: trend.failCount,\n      recentIncidents: trend.recentIncidents,\n      averageResponseTime: trend.averageResponseTime,\n\n      aiAnalysis: ai.ai_analysis || \"\"\n    }\n  }\n];"
      },
